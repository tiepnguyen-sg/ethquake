{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ethquake.dev/schemas/scenario-v1alpha1.json",
  "title": "Ethquake Scenario v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "ethquake.dev/v1alpha1" },
    "kind": { "const": "Scenario" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "topology", "fault", "thresholds", "methodology", "prediction", "limitations"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "topology": { "$ref": "#/$defs/topology" },
        "fault": { "$ref": "#/$defs/fault" },
        "thresholds": { "$ref": "#/$defs/thresholds" },
        "methodology": { "$ref": "#/$defs/methodology" },
        "prediction": { "$ref": "#/$defs/prediction" },
        "limitations": { "$ref": "#/$defs/limitations" }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "namespace_prefix"],
      "properties": {
        "chain_id": { "const": 3151908 },
        "namespace_prefix": { "const": "kt-ethquake-phase3-" }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "el_client", "cl_client", "beacon_target", "beacon_service_id", "execution_service_id", "validator_service_id", "validator_range_name", "validator_count"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "el_client": { "$ref": "#/$defs/name" },
        "cl_client": { "$ref": "#/$defs/name" },
        "beacon_target": { "$ref": "#/$defs/name" },
        "beacon_service_id": { "$ref": "#/$defs/name" },
        "execution_service_id": { "$ref": "#/$defs/name" },
        "validator_service_id": { "$ref": "#/$defs/name" },
        "validator_range_name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "validator_count": { "type": "integer", "minimum": 1 }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participants"],
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/participant" }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "share", "participants"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "share": { "const": 0.5 },
        "participants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "split_by", "layers", "duration_epochs", "groups"],
      "properties": {
        "type": { "const": "network_partition" },
        "split_by": { "const": "validator_weight" },
        "layers": {
          "type": "array",
          "prefixItems": [{ "const": "cl_p2p" }],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "duration_epochs": { "const": 3 },
        "groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_divergence_tolerance_slots", "realized_split_tolerance_fraction", "client_recovery_difference_slots"],
      "properties": {
        "head_divergence_tolerance_slots": { "const": 1 },
        "realized_split_tolerance_fraction": { "const": 0 },
        "client_recovery_difference_slots": { "const": 1 }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_repetitions", "fault_repetitions", "pairing", "order_seed", "run_order", "post_fault_observation_epochs"],
      "properties": {
        "control_repetitions": { "const": 3 },
        "fault_repetitions": { "const": 3 },
        "pairing": { "const": "by_repetition" },
        "order_seed": { "type": "string", "minLength": 1 },
        "run_order": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "pattern": "^(control|fault)-[1-3]$" }
        },
        "post_fault_observation_epochs": { "const": 4 }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_metric", "gate_a_rule", "gate_b_rule", "explanation"],
      "properties": {
        "primary_metric": { "const": "finalized_epoch_progress" },
        "gate_a_rule": { "const": "max_fault_target_strictly_less_than_min_paired_control_target_all_repetitions" },
        "gate_b_rule": { "const": "zero_fault_progress_and_recovery_all_repetitions" },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["does_not_prove"],
      "properties": {
        "does_not_prove": { "type": "string", "minLength": 1 }
      }
    }
  }
}
